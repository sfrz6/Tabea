# Neon PostgreSQL connection string.
# Use the pooled connection string from the Neon dashboard.
# Example: postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/tabea?sslmode=require
DATABASE_URL=

# Secret used to sign and verify session cookies.
# Generate a strong value, for example: openssl rand -base64 48
AUTH_SECRET=

# Public base URL of the deployment. Used for absolute links in notifications.
# Local development: http://localhost:3000
APP_URL=http://localhost:3000

# Session lifetime in days. Optional, defaults to 30.
SESSION_DAYS=30

# Default application timezone used when formatting dates.
# Optional, defaults to Asia/Muscat.
APP_TIMEZONE=Asia/Muscat

# Password used by the seed script for every development account.
# Optional, defaults to a documented development value. Never use a real password here.
SEED_PASSWORD=
